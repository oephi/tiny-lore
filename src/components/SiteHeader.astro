---
interface Props {
  backHref?: string;
  backLabel?: string;
  loginRedirect?: string;
}

const {
  backHref,
  backLabel = 'Back to the sky',
  loginRedirect = '/constellations',
} = Astro.props;
---

<header class="site-header">
  <div class="header-left">
    {backHref ? (
      <a href={backHref} class="back-link">&larr; {backLabel}</a>
    ) : (
      <div class="brand">
        <a href="/constellations" class="brand-link">
          <h1 class="brand-title">Tiny Lore</h1>
          <p class="brand-sub">Little Stories for Children</p>
        </a>
      </div>
    )}
  </div>

  <div class="header-right">
    <a href={`/api/user/login?redirect=${loginRedirect}`} class="sign-in-link" id="sign-in-link">Sign in</a>
    <button class="user-menu hidden" id="user-menu">
      <span class="user-initial" id="user-initial"></span>
    </button>
  </div>
</header>

<script>
  // Check auth state and toggle sign-in / user icon
  async function checkAuth() {
    try {
      const res = await fetch('/api/user/favorites');
      const data = await res.json();
      const signIn = document.getElementById('sign-in-link')!;
      const userMenu = document.getElementById('user-menu')!;
      const userInitial = document.getElementById('user-initial')!;

      if (data.loggedIn) {
        signIn.classList.add('hidden');
        userMenu.classList.remove('hidden');
        userInitial.textContent = '\u25CF';
      }
    } catch { /* silently fail */ }
  }

  checkAuth();

  document.getElementById('user-menu')?.addEventListener('click', () => {
    if (confirm('Sign out?')) {
      window.location.href = '/api/user/logout';
    }
  });
</script>

<style>
  .site-header {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 20;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 1.5rem 2.5rem;
    pointer-events: none;
  }

  .site-header > * {
    pointer-events: auto;
  }

  .header-left,
  .header-right {
    display: flex;
    align-items: center;
  }

  /* ── Brand ── */
  .brand-link {
    text-decoration: none;
  }

  .brand-title {
    font-family: 'Cormorant Garamond', serif;
    font-size: 1.3rem;
    font-weight: 400;
    color: #f5efe0;
    letter-spacing: 0.08em;
    text-shadow: 0 0 30px rgba(201, 168, 76, 0.25);
  }

  .brand-sub {
    font-size: 0.5rem;
    font-weight: 300;
    letter-spacing: 0.3em;
    text-transform: uppercase;
    color: #c9a84c;
    opacity: 0.5;
    margin-top: 0.15rem;
  }

  /* ── Back Link ── */
  .back-link {
    display: inline-block;
    font-family: 'Lato', sans-serif;
    font-size: 0.75rem;
    font-weight: 300;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: #c9a84c;
    text-decoration: none;
    opacity: 0.6;
    transition: opacity 0.2s;
  }

  .back-link:hover {
    opacity: 1;
  }

  /* ── Sign In ── */
  .sign-in-link {
    font-family: 'Lato', sans-serif;
    font-size: 0.7rem;
    font-weight: 300;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: #c9a84c;
    text-decoration: none;
    opacity: 0.5;
    transition: opacity 0.2s;
  }

  .sign-in-link:hover {
    opacity: 1;
  }

  /* ── User Menu ── */
  .user-menu {
    background: none;
    border: 1px solid rgba(201, 168, 76, 0.3);
    border-radius: 50%;
    width: 28px;
    height: 28px;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    color: #c9a84c;
    font-size: 0.7rem;
    opacity: 0.6;
    transition: opacity 0.2s;
  }

  .user-menu:hover {
    opacity: 1;
  }

  .hidden {
    display: none !important;
  }
</style>
