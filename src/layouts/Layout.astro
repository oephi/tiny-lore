---
interface Props {
  title?: string;
  description?: string;
}
const {
  title = 'Tiny Lore — Where tiny moments meet infinite worlds',
  description = 'Tiny Lore is an interactive constellation map of children\'s stories. Explore the night sky and discover tales told through the stars.',
} = Astro.props;
const canonicalUrl = new URL(Astro.url.pathname, Astro.site || 'https://tiny-lore.vercel.app');
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonicalUrl.href} />

  <!-- Open Graph -->
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:type" content="website" />
  <meta property="og:url" content={canonicalUrl.href} />
  <meta property="og:site_name" content="Tiny Lore" />

  <!-- Twitter -->
  <meta name="twitter:card" content="summary" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;0,600;1,300;1,400;1,500&family=Lato:wght@300;400;700&display=swap" rel="stylesheet" />
  <style is:global>
    *, *::before, *::after {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }
    :root {
      --bg: #072e2c;
      --text: #f5efe0;
      --gold: #c9a84c;
      --glow-sm: 0 0 30px rgba(201, 168, 76, 0.25);
      --glow-md: 0 0 40px rgba(201, 168, 76, 0.3);
      --glow-lg: 0 0 60px rgba(201, 168, 76, 0.3);
    }
    html, body {
      width: 100%;
      min-height: 100%;
      background: var(--bg);
      color: var(--text);
      font-family: 'Lato', sans-serif;
    }
  </style>
</head>
<body>
  <slot />
</body>
</html>
