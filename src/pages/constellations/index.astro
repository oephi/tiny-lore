---
import Layout from '../../layouts/Layout.astro';
import ConstellationCanvas from '../../components/ConstellationCanvas.astro';
import SiteHeader from '../../components/SiteHeader.astro';
---

<Layout>
  <div class="page-fade"></div>
  <ConstellationCanvas />
  <SiteHeader loginRedirect="/constellations" />
</Layout>

<style>
  .page-fade {
    position: fixed;
    inset: 0;
    z-index: 150;
    background: #072e2c;
    pointer-events: none;
    animation: fade-out 1.5s ease-out forwards;
  }

  @keyframes fade-out {
    0%   { opacity: 1; }
    100% { opacity: 0; }
  }
</style>
