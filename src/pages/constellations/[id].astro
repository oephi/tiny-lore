---
import Layout from '../../layouts/Layout.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const entries = await getCollection('constellations');
  return entries.filter((e) => !e.data.hidden).map((entry) => ({
    params: { id: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const { name, subtitle, color, image, quote, tracks } = entry.data;

// R2 bucket base URL — update this once your bucket is live
const AUDIO_BASE = import.meta.env.PUBLIC_AUDIO_BASE_URL || '/audio';
---

<Layout title={`${name} — Tiny Lore`} description={`${name}: ${subtitle}. A children's story told through the stars on Tiny Lore.`}>
  <!-- Entrance overlay that fades away -->
  <div class="entrance-overlay" id="entrance-overlay" style={`--accent: ${color};`}></div>

  <SiteHeader backHref="/constellations" />

  <div class="story-page">

    <article class="story">
      <header class="story-header">
        <p class="story-subtitle">{subtitle}</p>
        <h1 class="story-title" style={`--accent: ${color};`}>{name}</h1>
      </header>

      {image && (
        <div class="story-image">
          <img src={image} alt={name} width="320" height="190" />
        </div>
      )}

      {quote && (
        <blockquote class="story-quote">
          &ldquo;{quote}&rdquo;
        </blockquote>
      )}

      {tracks.length > 0 && (
        <div class="track-list" style={`--accent: ${color};`}>
          {tracks.map((track, i) => (
            <div
              class="track"
              data-src={`${AUDIO_BASE}/${track.file}`}
              data-index={i}
              data-title={track.title}
            >
              <span class="track-number">{String(i + 1).padStart(2, '0')}</span>
              <span class="track-info">
                <span class="track-title">{track.title}</span>
                <span class="track-duration">{track.duration}</span>
              </span>
              <span class="track-play-icon">&#9654;</span>
              <button
                class="fav-btn"
                data-track-id={`${entry.id}/${track.file}`}
                aria-label="Favorite"
              >
                <svg viewBox="0 0 24 24" class="heart-icon"><path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"/></svg>
              </button>
            </div>
          ))}
        </div>
      )}

      <div class="story-body">
        <Content />
      </div>

      <footer class="story-footer">
        <a href="/constellations" class="back-link">Return to the stars</a>
        <p class="copyright">&copy; Tiny Lore 2026 — Made with heart by humans.</p>
      </footer>
    </article>
  </div>
</Layout>

<script>
  function initStoryPage() {
    const tracks = document.querySelectorAll<HTMLDivElement>('.track');
    if (!tracks.length) return;

    let currentIndex = -1;
    let isPlaying = false;
    let loggedIn = false;
    let userFavorites: Set<string> = new Set();
    const ac = new AbortController();

    async function loadFavorites() {
      try {
        const res = await fetch('/api/user/favorites');
        const data = await res.json();
        loggedIn = data.loggedIn;
        userFavorites = new Set(data.favorites);

        document.querySelectorAll<HTMLButtonElement>('.fav-btn').forEach(btn => {
          if (loggedIn) {
            btn.classList.add('enabled');
            if (userFavorites.has(btn.dataset.trackId!)) {
              btn.classList.add('favorited');
            }
          } else {
            btn.classList.add('disabled');
            if (!btn.querySelector('.fav-tooltip')) {
              const tip = document.createElement('span');
              tip.className = 'fav-tooltip';
              tip.textContent = 'Sign in to save favourites';
              btn.appendChild(tip);
            }
          }
        });
      } catch { /* silently fail */ }
    }

    loadFavorites();
    window.addEventListener('auth-changed', () => loadFavorites(), { signal: ac.signal });

    document.querySelectorAll<HTMLButtonElement>('.fav-btn').forEach(btn => {
      btn.addEventListener('click', async (e) => {
        e.preventDefault();
        e.stopPropagation();
        if (!loggedIn) return;

        const trackId = btn.dataset.trackId!;
        btn.classList.toggle('favorited');

        try {
          const res = await fetch('/api/user/favorites', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ trackId }),
          });
          const data = await res.json();
          if (data.favorited) {
            userFavorites.add(trackId);
            btn.classList.add('favorited');
          } else {
            userFavorites.delete(trackId);
            btn.classList.remove('favorited');
          }
        } catch {
          btn.classList.toggle('favorited');
        }
      });
    });

    function buildPlaylist() {
      return Array.from(tracks).map(t => ({
        src: t.dataset.src!,
        title: t.dataset.title!,
        trackId: t.dataset.src!,
        color: getComputedStyle(t).getPropertyValue('--accent').trim() || '#c9a84c',
      }));
    }

    function playTrack(index: number) {
      const btn = tracks[index];
      if (!btn) return;

      tracks.forEach(t => t.classList.remove('active'));
      btn.classList.add('active');
      currentIndex = index;
      isPlaying = true;

      window.dispatchEvent(new CustomEvent('audio-play', {
        detail: {
          src: btn.dataset.src!,
          title: btn.dataset.title!,
          trackId: btn.dataset.src!,
          color: getComputedStyle(btn).getPropertyValue('--accent').trim() || '#c9a84c',
          playlist: buildPlaylist(),
        },
      }));
    }

    tracks.forEach((btn) => {
      btn.addEventListener('click', (e) => {
        if ((e.target as HTMLElement).closest('.fav-btn')) return;
        const index = Number(btn.dataset.index);
        if (index === currentIndex && isPlaying) {
          window.dispatchEvent(new Event('audio-pause'));
          isPlaying = false;
          btn.classList.remove('active');
        } else {
          playTrack(index);
        }
      });
    });

    window.addEventListener('audio-state', ((e: CustomEvent) => {
      const { playing, trackId } = e.detail;
      isPlaying = playing;
      tracks.forEach((t, i) => {
        if (t.dataset.src === trackId && playing) {
          t.classList.add('active');
          currentIndex = i;
        } else {
          t.classList.remove('active');
        }
      });
    }) as EventListener, { signal: ac.signal });

    // Check if something is already playing when the page loads
    const state = (window as any).__audioState?.();
    if (state?.playing) {
      tracks.forEach((t, i) => {
        if (t.dataset.src === state.trackId) {
          t.classList.add('active');
          currentIndex = i;
          isPlaying = true;
        }
      });
    }

    // Intercept back links — use browser back for the zoom-out effect
    document.querySelectorAll<HTMLAnchorElement>('a[href="/constellations"]').forEach(link => {
      link.addEventListener('click', (e) => {
        e.preventDefault();
        history.back();
      });
    });

    document.addEventListener('astro:before-swap', () => ac.abort(), { once: true });
  }

  initStoryPage();
  document.addEventListener('astro:after-swap', () => initStoryPage());
</script>

<style>
  .entrance-overlay {
    position: fixed;
    inset: 0;
    z-index: 50;
    pointer-events: none;
    background: radial-gradient(circle at 50% 50%, var(--accent), #072e2c);
    animation: entrance-fade 1.6s ease-in-out 0.2s forwards;
  }

  @keyframes entrance-fade {
    0%   { opacity: 1; }
    100% { opacity: 0; }
  }

  .story-page {
    min-height: 100vh;
    overflow-y: auto;
    background: #072e2c;
    padding: 5rem 2rem 2rem;
    animation: content-emerge 1.4s ease-out 0.3s both;
  }

  @keyframes content-emerge {
    0%   { opacity: 0; transform: scale(0.92) translateY(40px); }
    60%  { opacity: 1; transform: scale(1) translateY(8px); }
    100% { opacity: 1; transform: scale(1) translateY(0); }
  }

  .story {
    max-width: 600px;
    margin: 4rem auto;
  }

  .story-header {
    text-align: center;
    margin-bottom: 0;
  }

  .story-subtitle {
    font-family: 'Quicksand', sans-serif;
    font-size: 0.68rem;
    font-weight: 300;
    letter-spacing: 0.35em;
    text-transform: uppercase;
    margin-bottom: 1.2rem;
    color: #c9a84c;
    opacity: 0.7;
  }

  .story-title {
    font-family: 'Tan Mon Cheri', serif;
    font-size: clamp(1.5rem, 4vw, 2.4rem);
    font-weight: 300;
    color: #f5efe0;
    letter-spacing: 0.03em;
    line-height: 1.15;
    text-shadow: 0 0 40px color-mix(in srgb, var(--accent) 40%, transparent);
  }

  .ornament {
    color: #c9a84c;
    opacity: 0.3;
    font-size: 1.2rem;
    letter-spacing: 0.4rem;
    margin-top: 1.5rem;
  }

  /* ── Story Image ── */
  .story-image {
    display: flex;
    justify-content: center;
    margin: 2rem 0;
  }

  .story-image img {
    max-width: 320px;
    width: 100%;
    height: auto;
    object-fit: contain;
  }

  /* ── Story Quote ── */
  .story-quote {
    text-align: center;
    font-family: 'Quicksand', sans-serif;
    font-size: 1.1rem;
    font-weight: 300;
    font-style: italic;
    line-height: 1.6;
    color: rgba(245, 239, 224, 0.7);
    max-width: 360px;
    margin: 0 auto 2.5rem;
    border: none;
    padding: 0;
  }

  /* ── Track List ── */
  .track-list {
    display: flex;
    flex-direction: column;
    gap: 2px;
    margin-bottom: 3rem;
  }

  .track {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 0.85rem 1rem;
    background: rgba(245, 239, 224, 0.03);
    border: 1px solid rgba(245, 239, 224, 0.06);
    border-radius: 6px;
    cursor: pointer;
    transition: background 0.2s, border-color 0.2s;
    text-align: left;
    color: inherit;
    font: inherit;
  }

  .track:hover {
    background: rgba(245, 239, 224, 0.06);
    border-color: rgba(245, 239, 224, 0.12);
  }

  .track.active {
    background: color-mix(in srgb, var(--accent) 12%, transparent);
    border-color: color-mix(in srgb, var(--accent) 30%, transparent);
  }

  .track-number {
    font-family: 'Quicksand', sans-serif;
    font-size: 0.7rem;
    font-weight: 300;
    color: rgba(245, 239, 224, 0.3);
    min-width: 1.4rem;
  }

  .track-info {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
  }

  .track-title {
    font-family: 'Quicksand', sans-serif;
    font-size: 1.1rem;
    font-weight: 400;
    color: #f5efe0;
  }

  .track-duration {
    font-family: 'Quicksand', sans-serif;
    font-size: 0.65rem;
    font-weight: 300;
    color: rgba(245, 239, 224, 0.35);
    letter-spacing: 0.05em;
  }

  .track-play-icon {
    font-size: 0.7rem;
    color: rgba(245, 239, 224, 0.25);
    transition: color 0.2s;
  }

  .track:hover .track-play-icon,
  .track.active .track-play-icon {
    color: var(--accent);
  }

  /* ── Favorite Button ── */
  .fav-btn {
    background: none;
    border: none;
    cursor: pointer;
    padding: 0.3rem;
    flex-shrink: 0;
    transition: transform 0.2s, opacity 0.2s;
  }

  :global(.fav-btn.disabled) {
    cursor: not-allowed;
    position: relative;
  }

  :global(.fav-btn.disabled .heart-icon) {
    opacity: 0.25;
  }

  :global(.fav-btn.disabled):hover {
    transform: none;
  }

  :global(.fav-btn.disabled:hover .heart-icon) {
    opacity: 0.4;
  }

  :global(.fav-btn.disabled):active {
    transform: none;
  }

  :global(.fav-tooltip) {
    position: absolute;
    bottom: calc(100% + 4px);
    right: calc(100% + 8px);
    white-space: nowrap;
    font-family: 'Quicksand', sans-serif;
    font-size: 0.7rem;
    font-weight: 400;
    letter-spacing: 0.04em;
    color: #e0dce8;
    background-color: #2a2535;
    border: none;
    border-radius: 6px;
    padding: 0.5rem 0.85rem;
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.5);
    pointer-events: none;
    visibility: hidden;
    z-index: 50;
  }

  :global(.fav-tooltip)::after {
    content: '';
    position: absolute;
    bottom: 6px;
    left: 100%;
    border: 5px solid transparent;
    border-left-color: #2a2535;
  }

  :global(.fav-btn.disabled:hover .fav-tooltip) {
    visibility: visible;
  }

  .fav-btn:hover {
    transform: scale(1.2);
  }

  .fav-btn:active {
    transform: scale(0.9);
  }

  .heart-icon {
    width: 16px;
    height: 16px;
    fill: rgba(245, 239, 224, 0.15);
    transition: fill 0.2s;
  }

  .fav-btn:hover .heart-icon {
    fill: rgba(245, 239, 224, 0.3);
  }

  .fav-btn.favorited .heart-icon {
    fill: #e74c6f;
  }

  .fav-btn.favorited:hover .heart-icon {
    fill: #d43a5d;
  }

  /* ── Story Body ── */
  .story-body {
    font-family: 'Quicksand', sans-serif;
    font-size: 1.25rem;
    font-weight: 400;
    line-height: 1.85;
    color: #d4cbb5;
  }

  .story-body :global(p) {
    margin-bottom: 1.5rem;
    text-indent: 1.5em;
  }

  .story-body :global(p:first-child) {
    text-indent: 0;
  }

  .story-body :global(p:first-child::first-letter) {
    font-size: 3.2em;
    float: left;
    line-height: 0.8;
    margin-right: 0.08em;
    margin-top: 0.05em;
    color: #f5efe0;
    font-weight: 600;
  }

  .story-footer {
    text-align: center;
    margin-top: 4rem;
    padding-top: 2rem;
    border-top: 1px solid rgba(201, 168, 76, 0.12);
  }

  .story-footer .back-link {
    display: inline-block;
    font-family: 'Quicksand', sans-serif;
    font-size: 0.75rem;
    font-weight: 300;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: #c9a84c;
    text-decoration: none;
    opacity: 0.6;
    transition: opacity 0.2s;
    margin-top: 2rem;
  }

  .story-footer .back-link:hover {
    opacity: 1;
  }

  .copyright {
    font-family: 'Quicksand', sans-serif;
    font-size: 0.55rem;
    font-weight: 300;
    letter-spacing: 0.1em;
    color: rgba(245, 239, 224, 0.15);
    margin-top: 3rem;
  }
</style>
