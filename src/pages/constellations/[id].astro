---
import Layout from '../../layouts/Layout.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const entries = await getCollection('constellations');
  return entries.map((entry) => ({
    params: { id: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const { name, subtitle, color, tracks } = entry.data;

// R2 bucket base URL — update this once your bucket is live
const AUDIO_BASE = import.meta.env.PUBLIC_AUDIO_BASE_URL || '/audio';
---

<Layout title={`${name} — Tiny Lore`} description={`${name}: ${subtitle}. A children's story told through the stars on Tiny Lore.`}>
  <!-- Entrance overlay that fades away -->
  <div class="entrance-overlay" id="entrance-overlay" style={`--accent: ${color};`}></div>

  <SiteHeader backHref="/constellations" loginRedirect={`/constellations/${entry.id}`} />

  <div class="story-page">

    <article class="story">
      <header class="story-header">
        <p class="story-subtitle">{subtitle}</p>
        <h1 class="story-title" style={`--accent: ${color};`}>{name}</h1>
        <div class="ornament">&#10022;</div>
      </header>

      {tracks.length > 0 && (
        <div class="track-list" style={`--accent: ${color};`}>
          {tracks.map((track, i) => (
            <div
              class="track"
              data-src={`${AUDIO_BASE}/${track.file}`}
              data-index={i}
              data-title={track.title}
            >
              <span class="track-number">{String(i + 1).padStart(2, '0')}</span>
              <span class="track-info">
                <span class="track-title">{track.title}</span>
                <span class="track-duration">{track.duration}</span>
              </span>
              <span class="track-play-icon">&#9654;</span>
              <button
                class="fav-btn"
                data-track-id={`${entry.id}/${track.file}`}
                aria-label="Favorite"
              >
                <svg viewBox="0 0 24 24" class="heart-icon"><path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"/></svg>
              </button>
            </div>
          ))}
        </div>
      )}

      <!-- Sticky player bar — hidden until a track is selected -->
      <div class="player hidden" id="player" style={`--accent: ${color};`}>
        <div class="player-inner">
          <button class="player-btn" id="player-play">&#9654;</button>
          <div class="player-details">
            <span class="player-title" id="player-title"></span>
            <div class="player-progress">
              <div class="player-bar" id="player-bar">
                <div class="player-fill" id="player-fill"></div>
              </div>
              <span class="player-time" id="player-time">0:00 / 0:00</span>
            </div>
          </div>
        </div>
      </div>

      <div class="story-body">
        <Content />
      </div>

      <footer class="story-footer">
        <div class="ornament">&#10022; &nbsp; &#10022; &nbsp; &#10022;</div>
        <a href="/constellations" class="back-link">Return to the stars</a>
      </footer>
    </article>
  </div>
</Layout>

<script>
  import { formatTime as fmt } from '../../scripts/format';

  const audio = new Audio();
  const player = document.getElementById('player')!;
  const playBtn = document.getElementById('player-play')!;
  const titleEl = document.getElementById('player-title')!;
  const fillEl = document.getElementById('player-fill')!;
  const barEl = document.getElementById('player-bar')!;
  const timeEl = document.getElementById('player-time')!;
  const tracks = document.querySelectorAll<HTMLDivElement>('.track');

  let currentIndex = -1;
  let isPlaying = false;
  let loggedIn = false;
  let userFavorites: Set<string> = new Set();

  // Fetch user favorites and auth state on load
  async function loadFavorites() {
    try {
      const res = await fetch('/api/user/favorites');
      const data = await res.json();
      loggedIn = data.loggedIn;
      userFavorites = new Set(data.favorites);

      document.querySelectorAll<HTMLButtonElement>('.fav-btn').forEach(btn => {
        if (loggedIn) {
          btn.classList.add('enabled');
          if (userFavorites.has(btn.dataset.trackId!)) {
            btn.classList.add('favorited');
          }
        } else {
          btn.classList.add('disabled');
          // Add custom tooltip
          const tip = document.createElement('span');
          tip.className = 'fav-tooltip';
          tip.textContent = 'Sign in to save favourites';
          btn.appendChild(tip);
        }
      });
    } catch { /* silently fail */ }
  }

  loadFavorites();

  // Handle favorite button clicks
  document.querySelectorAll<HTMLButtonElement>('.fav-btn').forEach(btn => {
    btn.addEventListener('click', async (e) => {
      e.preventDefault();
      e.stopPropagation();

      if (!loggedIn) {
        return;
      }

      const trackId = btn.dataset.trackId!;
      btn.classList.toggle('favorited');

      try {
        const res = await fetch('/api/user/favorites', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ trackId }),
        });
        const data = await res.json();
        if (data.favorited) {
          userFavorites.add(trackId);
          btn.classList.add('favorited');
        } else {
          userFavorites.delete(trackId);
          btn.classList.remove('favorited');
        }
      } catch {
        // Revert on error
        btn.classList.toggle('favorited');
      }
    });
  });

  // Select and play a track by index
  function playTrack(index: number) {
    const btn = tracks[index];
    if (!btn) return;

    // Update active track styling
    tracks.forEach(t => t.classList.remove('active'));
    btn.classList.add('active');

    // Load and play
    const src = btn.dataset.src!;
    const title = btn.dataset.title!;
    currentIndex = index;
    audio.src = src;
    audio.play();
    isPlaying = true;

    // Show player
    player.classList.remove('hidden');
    titleEl.textContent = title;
    playBtn.innerHTML = '&#9646;&#9646;';
  }

  // Track click handlers
  tracks.forEach((btn) => {
    btn.addEventListener('click', (e) => {
      // Ignore clicks on the favorite button
      if ((e.target as HTMLElement).closest('.fav-btn')) return;
      const index = Number(btn.dataset.index);
      if (index === currentIndex && isPlaying) {
        // Clicking active track pauses it
        audio.pause();
        isPlaying = false;
        playBtn.innerHTML = '&#9654;';
        btn.classList.remove('active');
      } else {
        playTrack(index);
      }
    });
  });

  // Play/pause button in the player bar
  playBtn.addEventListener('click', () => {
    if (isPlaying) {
      audio.pause();
      isPlaying = false;
      playBtn.innerHTML = '&#9654;';
      tracks[currentIndex]?.classList.remove('active');
    } else {
      audio.play();
      isPlaying = true;
      playBtn.innerHTML = '&#9646;&#9646;';
      tracks[currentIndex]?.classList.add('active');
    }
  });

  // Progress bar updates
  audio.addEventListener('timeupdate', () => {
    if (!audio.duration) return;
    const pct = (audio.currentTime / audio.duration) * 100;
    fillEl.style.width = pct + '%';
    timeEl.textContent = `${fmt(audio.currentTime)} / ${fmt(audio.duration)}`;
  });

  // Click to seek on the progress bar
  barEl.addEventListener('click', (e) => {
    const rect = barEl.getBoundingClientRect();
    const pct = (e.clientX - rect.left) / rect.width;
    audio.currentTime = pct * audio.duration;
  });

  // Auto-play next track when current one ends
  audio.addEventListener('ended', () => {
    const next = currentIndex + 1;
    if (next < tracks.length) {
      playTrack(next);
    } else {
      isPlaying = false;
      playBtn.innerHTML = '&#9654;';
      tracks[currentIndex]?.classList.remove('active');
    }
  });

  // Intercept back links — use browser back to get the nice pageshow restore
  document.querySelectorAll<HTMLAnchorElement>('a[href="/constellations"]').forEach(link => {
    link.addEventListener('click', (e) => {
      e.preventDefault();
      if (isPlaying) {
        audio.pause();
        isPlaying = false;
      }
      history.back();
    });
  });
</script>

<style>
  .entrance-overlay {
    position: fixed;
    inset: 0;
    z-index: 50;
    pointer-events: none;
    background: radial-gradient(circle at 50% 50%, var(--accent), #072e2c);
    animation: entrance-fade 1.6s ease-in-out 0.2s forwards;
  }

  @keyframes entrance-fade {
    0%   { opacity: 1; }
    100% { opacity: 0; }
  }

  .story-page {
    min-height: 100vh;
    overflow-y: auto;
    background: #072e2c;
    padding: 5rem 2rem 2rem;
    animation: content-emerge 1.4s ease-out 0.3s both;
  }

  @keyframes content-emerge {
    0%   { opacity: 0; transform: scale(0.92) translateY(40px); }
    60%  { opacity: 1; transform: scale(1) translateY(8px); }
    100% { opacity: 1; transform: scale(1) translateY(0); }
  }

  .story {
    max-width: 600px;
    margin: 4rem auto;
  }

  .story-header {
    text-align: center;
    margin-bottom: 3.5rem;
  }

  .story-subtitle {
    font-family: 'Lato', sans-serif;
    font-size: 0.68rem;
    font-weight: 300;
    letter-spacing: 0.35em;
    text-transform: uppercase;
    color: #c9a84c;
    opacity: 0.7;
    margin-bottom: 0.75rem;
  }

  .story-title {
    font-family: 'Cormorant Garamond', serif;
    font-size: clamp(2.2rem, 6vw, 3.4rem);
    font-weight: 300;
    color: #f5efe0;
    letter-spacing: 0.03em;
    line-height: 1.15;
    text-shadow: 0 0 40px color-mix(in srgb, var(--accent) 40%, transparent);
  }

  .ornament {
    color: #c9a84c;
    opacity: 0.3;
    font-size: 1.2rem;
    letter-spacing: 0.4rem;
    margin-top: 1.5rem;
  }

  /* ── Track List ── */
  .track-list {
    display: flex;
    flex-direction: column;
    gap: 2px;
    margin-bottom: 3rem;
  }

  .track {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 0.85rem 1rem;
    background: rgba(245, 239, 224, 0.03);
    border: 1px solid rgba(245, 239, 224, 0.06);
    border-radius: 6px;
    cursor: pointer;
    transition: background 0.2s, border-color 0.2s;
    text-align: left;
    color: inherit;
    font: inherit;
  }

  .track:hover {
    background: rgba(245, 239, 224, 0.06);
    border-color: rgba(245, 239, 224, 0.12);
  }

  .track.active {
    background: color-mix(in srgb, var(--accent) 12%, transparent);
    border-color: color-mix(in srgb, var(--accent) 30%, transparent);
  }

  .track-number {
    font-family: 'Lato', sans-serif;
    font-size: 0.7rem;
    font-weight: 300;
    color: rgba(245, 239, 224, 0.3);
    min-width: 1.4rem;
  }

  .track-info {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
  }

  .track-title {
    font-family: 'Cormorant Garamond', serif;
    font-size: 1.1rem;
    font-weight: 400;
    color: #f5efe0;
  }

  .track-duration {
    font-family: 'Lato', sans-serif;
    font-size: 0.65rem;
    font-weight: 300;
    color: rgba(245, 239, 224, 0.35);
    letter-spacing: 0.05em;
  }

  .track-play-icon {
    font-size: 0.7rem;
    color: rgba(245, 239, 224, 0.25);
    transition: color 0.2s;
  }

  .track:hover .track-play-icon,
  .track.active .track-play-icon {
    color: var(--accent);
  }

  /* ── Favorite Button ── */
  .fav-btn {
    background: none;
    border: none;
    cursor: pointer;
    padding: 0.3rem;
    flex-shrink: 0;
    transition: transform 0.2s, opacity 0.2s;
  }

  :global(.fav-btn.disabled) {
    cursor: not-allowed;
    position: relative;
  }

  :global(.fav-btn.disabled .heart-icon) {
    opacity: 0.25;
  }

  :global(.fav-btn.disabled):hover {
    transform: none;
  }

  :global(.fav-btn.disabled:hover .heart-icon) {
    opacity: 0.4;
  }

  :global(.fav-btn.disabled):active {
    transform: none;
  }

  :global(.fav-tooltip) {
    position: absolute;
    bottom: calc(100% + 4px);
    right: calc(100% + 8px);
    white-space: nowrap;
    font-family: 'Lato', sans-serif;
    font-size: 0.7rem;
    font-weight: 400;
    letter-spacing: 0.04em;
    color: #e0dce8;
    background-color: #2a2535;
    border: none;
    border-radius: 6px;
    padding: 0.5rem 0.85rem;
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.5);
    pointer-events: none;
    visibility: hidden;
    z-index: 50;
  }

  :global(.fav-tooltip)::after {
    content: '';
    position: absolute;
    bottom: 6px;
    left: 100%;
    border: 5px solid transparent;
    border-left-color: #2a2535;
  }

  :global(.fav-btn.disabled:hover .fav-tooltip) {
    visibility: visible;
  }

  .fav-btn:hover {
    transform: scale(1.2);
  }

  .fav-btn:active {
    transform: scale(0.9);
  }

  .heart-icon {
    width: 16px;
    height: 16px;
    fill: rgba(245, 239, 224, 0.15);
    transition: fill 0.2s;
  }

  .fav-btn:hover .heart-icon {
    fill: rgba(245, 239, 224, 0.3);
  }

  .fav-btn.favorited .heart-icon {
    fill: #e74c6f;
  }

  .fav-btn.favorited:hover .heart-icon {
    fill: #d43a5d;
  }

  /* ── Player Bar ── */
  .player {
    position: sticky;
    bottom: 1rem;
    z-index: 30;
    margin: 1.5rem -0.5rem 2rem;
    transition: opacity 0.3s, transform 0.3s;
  }

  .player.hidden {
    opacity: 0;
    transform: translateY(10px);
    pointer-events: none;
  }

  .player-inner {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    padding: 0.75rem 1rem;
    background: rgba(7, 46, 44, 0.92);
    backdrop-filter: blur(12px);
    border: 1px solid color-mix(in srgb, var(--accent) 20%, transparent);
    border-radius: 10px;
    box-shadow: 0 4px 24px rgba(0, 0, 0, 0.4);
  }

  .player-btn {
    width: 36px;
    height: 36px;
    border-radius: 50%;
    border: 1px solid color-mix(in srgb, var(--accent) 40%, transparent);
    background: color-mix(in srgb, var(--accent) 10%, transparent);
    color: var(--accent);
    font-size: 0.75rem;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    transition: background 0.2s;
  }

  .player-btn:hover {
    background: color-mix(in srgb, var(--accent) 20%, transparent);
  }

  .player-details {
    flex: 1;
    min-width: 0;
  }

  .player-title {
    display: block;
    font-family: 'Cormorant Garamond', serif;
    font-size: 0.95rem;
    color: #f5efe0;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    margin-bottom: 0.35rem;
  }

  .player-progress {
    display: flex;
    align-items: center;
    gap: 0.6rem;
  }

  .player-bar {
    flex: 1;
    height: 4px;
    background: rgba(245, 239, 224, 0.1);
    border-radius: 2px;
    cursor: pointer;
    overflow: hidden;
  }

  .player-fill {
    height: 100%;
    width: 0%;
    background: var(--accent);
    border-radius: 2px;
    transition: width 0.1s linear;
  }

  .player-time {
    font-family: 'Lato', sans-serif;
    font-size: 0.6rem;
    font-weight: 300;
    color: rgba(245, 239, 224, 0.35);
    white-space: nowrap;
  }

  /* ── Story Body ── */
  .story-body {
    font-family: 'Cormorant Garamond', serif;
    font-size: 1.25rem;
    font-weight: 400;
    line-height: 1.85;
    color: #d4cbb5;
  }

  .story-body :global(p) {
    margin-bottom: 1.5rem;
    text-indent: 1.5em;
  }

  .story-body :global(p:first-child) {
    text-indent: 0;
  }

  .story-body :global(p:first-child::first-letter) {
    font-size: 3.2em;
    float: left;
    line-height: 0.8;
    margin-right: 0.08em;
    margin-top: 0.05em;
    color: #f5efe0;
    font-weight: 600;
  }

  .story-footer {
    text-align: center;
    margin-top: 4rem;
    padding-top: 2rem;
    border-top: 1px solid rgba(201, 168, 76, 0.12);
  }

  .story-footer .back-link {
    display: inline-block;
    font-family: 'Lato', sans-serif;
    font-size: 0.75rem;
    font-weight: 300;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: #c9a84c;
    text-decoration: none;
    opacity: 0.6;
    transition: opacity 0.2s;
    margin-top: 2rem;
  }

  .story-footer .back-link:hover {
    opacity: 1;
  }
</style>
