---
import Layout from '../../layouts/Layout.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const entries = await getCollection('constellations');
  return entries.map((entry) => ({
    params: { id: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const { name, subtitle, color } = entry.data;
---

<Layout title={`${name} — Tiny Lore`}>
  <!-- Entrance overlay that fades away -->
  <div class="entrance-overlay" style={`--accent: ${color};`}></div>

  <div class="story-page">
    <a href="/constellations" class="back-link">&larr; Back to the sky</a>

    <article class="story">
      <header class="story-header">
        <p class="story-subtitle">{subtitle}</p>
        <h1 class="story-title" style={`--accent: ${color};`}>{name}</h1>
        <div class="ornament">&#10022;</div>
      </header>

      <div class="story-body">
        <Content />
      </div>

      <footer class="story-footer">
        <div class="ornament">&#10022; &nbsp; &#10022; &nbsp; &#10022;</div>
        <a href="/constellations" class="back-link">Return to the stars</a>
      </footer>
    </article>
  </div>
</Layout>

<style>
  .entrance-overlay {
    position: fixed;
    inset: 0;
    z-index: 50;
    pointer-events: none;
    background: radial-gradient(circle at 50% 50%, var(--accent), #072e2c);
    animation: entrance-fade 1.2s ease-out 0.1s forwards;
  }

  @keyframes entrance-fade {
    0%   { opacity: 1; }
    100% { opacity: 0; }
  }

  .story-page {
    min-height: 100vh;
    overflow-y: auto;
    background: #072e2c;
    padding: 2rem;
    animation: content-rise 1s ease-out 0.2s both;
  }

  @keyframes content-rise {
    0%   { opacity: 0; transform: translateY(30px); }
    100% { opacity: 1; transform: translateY(0); }
  }

  .back-link {
    display: inline-block;
    font-family: 'Lato', sans-serif;
    font-size: 0.75rem;
    font-weight: 300;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: #c9a84c;
    text-decoration: none;
    opacity: 0.6;
    transition: opacity 0.2s;
  }

  .back-link:hover {
    opacity: 1;
  }

  .story {
    max-width: 600px;
    margin: 4rem auto;
  }

  .story-header {
    text-align: center;
    margin-bottom: 3.5rem;
  }

  .story-subtitle {
    font-family: 'Lato', sans-serif;
    font-size: 0.68rem;
    font-weight: 300;
    letter-spacing: 0.35em;
    text-transform: uppercase;
    color: #c9a84c;
    opacity: 0.7;
    margin-bottom: 0.75rem;
  }

  .story-title {
    font-family: 'Cormorant Garamond', serif;
    font-size: clamp(2.2rem, 6vw, 3.4rem);
    font-weight: 300;
    color: #f5efe0;
    letter-spacing: 0.03em;
    line-height: 1.15;
    text-shadow: 0 0 40px color-mix(in srgb, var(--accent) 40%, transparent);
  }

  .ornament {
    color: #c9a84c;
    opacity: 0.3;
    font-size: 1.2rem;
    letter-spacing: 0.4rem;
    margin-top: 1.5rem;
  }

  .story-body {
    font-family: 'Cormorant Garamond', serif;
    font-size: 1.25rem;
    font-weight: 400;
    line-height: 1.85;
    color: #d4cbb5;
  }

  .story-body :global(p) {
    margin-bottom: 1.5rem;
    text-indent: 1.5em;
  }

  .story-body :global(p:first-child) {
    text-indent: 0;
  }

  .story-body :global(p:first-child::first-letter) {
    font-size: 3.2em;
    float: left;
    line-height: 0.8;
    margin-right: 0.08em;
    margin-top: 0.05em;
    color: #f5efe0;
    font-weight: 600;
  }

  .story-footer {
    text-align: center;
    margin-top: 4rem;
    padding-top: 2rem;
    border-top: 1px solid rgba(201, 168, 76, 0.12);
  }

  .story-footer .back-link {
    margin-top: 2rem;
  }
</style>
