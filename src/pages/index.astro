---
import Layout from '../layouts/Layout.astro';
---

<Layout>
  <div class="landing">
    <canvas id="landing-stars"></canvas>
    <div class="landing-content">
      <h1 class="landing-title">Tiny Lore</h1>
      <p class="landing-sub">Where tiny moments meet infinite worlds</p>
      <p class="landing-cta">click to enter</p>
    </div>
  </div>
</Layout>

<style>
  .landing {
    position: fixed;
    inset: 0;
    background: #072e2c;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    user-select: none;
  }

  .landing.transitioning {
    pointer-events: none;
  }

  #landing-stars {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .landing-content {
    position: relative;
    z-index: 1;
    text-align: center;
  }

  .landing-title {
    font-family: 'Cormorant Garamond', serif;
    font-size: clamp(3.5rem, 10vw, 7rem);
    font-weight: 300;
    color: #f5efe0;
    letter-spacing: 0.08em;
    text-shadow: 0 0 60px rgba(201, 168, 76, 0.3);
  }

  .landing-sub {
    font-family: 'Lato', sans-serif;
    font-size: 0.75rem;
    font-weight: 300;
    letter-spacing: 0.4em;
    text-transform: uppercase;
    color: #c9a84c;
    opacity: 0.6;
    margin-top: 0.5rem;
  }

  .landing-cta {
    font-family: 'Lato', sans-serif;
    font-size: 0.65rem;
    font-weight: 300;
    letter-spacing: 0.3em;
    text-transform: uppercase;
    color: rgba(245, 239, 224, 0.2);
    margin-top: 3rem;
    animation: pulse-cta 3s ease-in-out infinite;
  }

  @keyframes pulse-cta {
    0%, 100% { opacity: 0.2; }
    50% { opacity: 0.5; }
  }
</style>

<script>
  const landingCanvas = document.getElementById('landing-stars') as HTMLCanvasElement;
  const lctx = landingCanvas.getContext('2d')!;
  let landingStars: { x: number; y: number; r: number; alpha: number; speed: number; phase: number }[] = [];

  function resizeLanding() {
    landingCanvas.width = window.innerWidth * devicePixelRatio;
    landingCanvas.height = window.innerHeight * devicePixelRatio;
    landingCanvas.style.width = window.innerWidth + 'px';
    landingCanvas.style.height = window.innerHeight + 'px';
    lctx.setTransform(devicePixelRatio, 0, 0, devicePixelRatio, 0, 0);
    seedLandingStars();
  }

  function seedLandingStars() {
    landingStars = [];
    const w = window.innerWidth;
    const h = window.innerHeight;
    for (let i = 0; i < 200; i++) {
      landingStars.push({
        x: Math.random() * w,
        y: Math.random() * h,
        r: Math.random() * 1.3 + 0.2,
        alpha: Math.random() * 0.5 + 0.05,
        speed: Math.random() * 0.4 + 0.1,
        phase: Math.random() * Math.PI * 2,
      });
    }
  }

  let lt = 0;
  let landingActive = true;

  function drawLanding() {
    if (!landingActive) return;
    lt += 0.01;
    const w = window.innerWidth;
    const h = window.innerHeight;
    lctx.clearRect(0, 0, w, h);
    for (const s of landingStars) {
      const a = s.alpha * (0.4 + 0.6 * Math.sin(lt * s.speed + s.phase));
      lctx.beginPath();
      lctx.arc(s.x, s.y, s.r, 0, Math.PI * 2);
      lctx.fillStyle = `rgba(220, 230, 255, ${a})`;
      lctx.fill();
    }
    requestAnimationFrame(drawLanding);
  }

  window.addEventListener('resize', resizeLanding);
  resizeLanding();
  drawLanding();

  const landing = document.querySelector('.landing')!;

  landing.addEventListener('click', () => {
    landing.classList.add('transitioning');

    const content = landing.querySelector('.landing-content') as HTMLElement;

    // Title rises and fades
    content.style.transition = 'opacity 1.2s ease, transform 1.2s ease';
    content.style.opacity = '0';
    content.style.transform = 'translateY(-30px)';

    // Landing fades out then navigate
    setTimeout(() => {
      landing.style.transition = 'opacity 1.5s ease';
      landing.style.opacity = '0';
    }, 600);

    setTimeout(() => {
      window.location.href = '/constellations';
    }, 1800);
  });
</script>
