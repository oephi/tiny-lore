---
import Layout from '../layouts/Layout.astro';
import ConstellationCanvas from '../components/ConstellationCanvas.astro';
---

<Layout>
  <ConstellationCanvas />

  <!-- Branding overlay -->
  <header id="brand">
    <h1 class="brand-title">Tiny Lore</h1>
    <p class="brand-sub">Little Stories for Children</p>
  </header>
</Layout>

<style>
  #brand {
    position: fixed;
    top: 2.5rem;
    left: 50%;
    transform: translateX(-50%);
    text-align: center;
    z-index: 20;
    pointer-events: none;
    transition: opacity 0.8s ease;
  }

  .brand-title {
    font-family: 'Cormorant Garamond', serif;
    font-size: clamp(2rem, 5vw, 3.2rem);
    font-weight: 300;
    color: #f5efe0;
    letter-spacing: 0.1em;
    text-shadow: 0 0 40px rgba(201, 168, 76, 0.3);
  }

  .brand-sub {
    font-size: 0.65rem;
    font-weight: 300;
    letter-spacing: 0.35em;
    text-transform: uppercase;
    color: #c9a84c;
    opacity: 0.6;
    margin-top: 0.3rem;
  }
</style>
